# Environment variables for Preniche
# PostgreSQL Database URL for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/preniche_db?schema=public"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth / JWT secret for campus auth
NEXTAUTH_SECRET="preniche-campus-thrift-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"
